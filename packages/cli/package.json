{
  "name": "vibeguard",
  "version": "0.1.0",
  "description": "The safety net for vibe coding. Auto-snapshot, architecture guard, smart recovery.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vibeguard": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist"
  },
  "keywords": ["vibeguard", "vibe-coding", "ai", "snapshot", "architecture", "cli", "mcp"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chenglin1112/vibeguard.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@vibeguard/shared": "workspace:^",
    "@vibeguard/core": "workspace:^",
    "citty": "^0.1.6",
    "consola": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
