{
  "name": "@vibeguard/core",
  "version": "0.1.0",
  "description": "Core engine for VibeGuard — snapshot, architecture analysis, health scoring",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
